{
  "routes": [
    {
      "src": "/(auth|track|profile|admin|dashboard|customer-portal)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/catalog/?",
      "headers": {
        "Location": "/products"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/about-lourex/?",
      "dest": "/about-lourex/index.html"
    },
    {
      "src": "/chocolate-sourcing/?",
      "dest": "/chocolate-sourcing/index.html"
    },
    {
      "src": "/biscuits-sourcing/?",
      "dest": "/biscuits-sourcing/index.html"
    },
    {
      "src": "/food-products-sourcing/?",
      "dest": "/food-products-sourcing/index.html"
    },
    {
      "src": "/turkish-products/?",
      "dest": "/turkish-products/index.html"
    },
    {
      "src": "/syrian-products/?",
      "dest": "/syrian-products/index.html"
    },
    {
      "src": "/products/?",
      "dest": "/products/index.html"
    },
    {
      "src": "/(about|faq|privacy|terms|guidelines|why-lourex|contact|request|smart-rfq|track|auth|profile|admin)/?",
      "dest": "/spa.html"
    },
    {
      "src": "/products/[^/]+/?",
      "dest": "/spa.html"
    },
    {
      "src": "/(dashboard|customer-portal)(/.*)?",
      "dest": "/spa.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
